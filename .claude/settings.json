{
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(.venv/bin/pytest:*)",
      "Bash(ruff:*)",
      "Bash(.venv/bin/ruff:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(source .venv/bin/activate)",
      "Bash(gh run watch:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker volume ls:*)"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 .claude/hooks/ruff_edited_file.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 .claude/hooks/report_tests.py"
          }
        ]
      }
    ]
  }
}
